{
  "private": true,
    "scripts": {
        "clean": "rimraf wwwroot/assets",
        "dev": "vite --config vite.config.js",
        "build": "vite --config vite.config.js build",
        "watch": "vite --config vite.config.js build --mode development --watch",
        "preview": "vite --config vite.config.js preview",
        "build:manager": "vite --config vite-manager.config.js build",
        "watch:manager": "vite --config vite-manager.config.js build --mode development --watch",
        "publish": "npm run build && npm run build:manager"
    },
  "type": "module",
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "glob": "^10.3.10",
    "sass": "^1.77.0",
    "vite": "^5.2.11",
    "vite-plugin-static-copy": "^1.0.4",
    "vue": "^2.6.14",
    "vue-template-compiler": "^2.6.14"
  },
  "dependencies": {
    "animejs": "^3.2.1",
    "glob": "^8.0.3",
    "js-cookie": "^3.0.5",
    "micromodal": "^0.4.10",
    "photoswipe": "^5.3.3",
    "pristine": "^0.0.1",
    "pristinejs": "^0.1.9",
    "simplelightbox": "^2.10.4",
    "swiper": "^11.0.5"
  }
}
