{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "piranha": "Data Source=piranha.db",
    "blobstorage": "DefaultEndpointsProtocol=https;AccountName=;AccountKey=;EndpointSuffix="
  },
  "MailSettings": {
    "FromAddress": "etc@example.com",
    "FromName": "Harry Example",
    "SmtpClient": {
      "User": "etc@example.com",
      "Server": "host.etc.com",
      "Port": 465,
      "Password": "",
      "UseSsl": true,
      "RequiresAuthentication": true
    },
    "SendToWhitelist": [ "soundintheory", "email", "contains", "phrase", "etc" ]
  },
  "Mapbox": {
    "AccessToken": "",
    "ServerAccessToken": ""
  },
  "OutputCache": {
    "Enabled": false
  },
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": "",
    "Enabled": false
  },
  "Sentry": {
    "Dsn": "",
    "Debug": false,
    "TracesSampleRate": 1.0,
    "SendDefaultPii": true
  },
  "MailingListSettings": {
    "ApiKeys": {
        "CampaignMonitor": "",
        "MailChimp": ""
    }
  }
}
